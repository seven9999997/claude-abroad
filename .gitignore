# macOS
.DS_Store

# 构建产物
/build/
/dist/
/bin/
*.test
*.out
coverage.*

# 虚拟机镜像构建产物和下载缓存（由 cmd/abroad-imagebuild 生成）
/guest/out/

# 开发脚本的输出
/scripts/dev/out/

# Xcode
/app/build/
/app/DerivedData/
xcuserdata/
*.xcuserstate

# 前端依赖
node_modules/

# Claude Code 本机设置（个人的，不入库）
.claude/settings.local.json

# M0 验证脚本的输出（日志、pcap、编译出的探测程序）
/scripts/m0/*/out/
/m0-r2-probe
/abroad-*

# 各阶段脚本的输出、误放的编译产物
/scripts/*/out/
/abroadd
/cmd/abroadd/abroadd

# 本机私人信息（会话日志、需要用户处理的事、隐私检查的本地模式）
/docs/LOCAL.md
/docs/LOCAL.patterns

# 本机工具的附件目录
/.cc-connect/

# M5-1 探查：结果文件和 Swift 的构建目录
scripts/m5/probe/out/
scripts/m5/probe/swift/.build/
